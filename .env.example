# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_HOST_AUTH_METHOD=trust
POSTGRES_PORT=5432

# Database Names
CONDUIT_DB=conduit_db
GITEA_DB=gitea_db
PACTBROKER_DB=pactbroker_db

# Service Ports
APP_PORT=3000
GITEA_PORT=3001
GITEA_SSH_PORT=2222
PACT_BROKER_PORT=9292

# Gitea Configuration
GITEA_ADMIN_USER=devops
GITEA_ADMIN_PASSWORD=devops123
GITEA_ADMIN_EMAIL=devops@example.com
GITEA_RUNNER_TOKEN=change-me-gitea-runner-token

# Application Configuration
SECRET_KEY=your-secret-key-change-in-production-minimum-32-characters
APP_ENV=prod
DATABASE_URL=postgresql://postgres@db:5432/conduit_db
